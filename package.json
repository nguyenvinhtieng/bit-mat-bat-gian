{
  "name": "the-hidden-truth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "layout:gen": "tsx tools/layout-gen/gen.ts",
    "map:compile": "tsx tools/map-compile/compile.ts",
    "assets:pack": "node tools/assets-pack/pack.mjs",
    "assets:check": "node tools/assets-pack/check.mjs",
    "prepare:data": "pnpm layout:gen && pnpm map:compile",
    "dev": "pnpm prepare:data && pnpm -r --parallel --filter ./apps/* dev",
    "dev:server": "pnpm --filter @hidden-truth/server dev",
    "dev:web": "pnpm --filter @hidden-truth/web dev",
    "build": "pnpm prepare:data && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @hidden-truth/shared test",
    "smoke": "tsx tools/smoke/bots.ts",
    "screenshot": "tsx tools/smoke/screenshot.ts"
  },
  "devDependencies": {
    "@hidden-truth/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "colyseus.js": "0.16.22",
    "playwright-core": "^1.64.0",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
