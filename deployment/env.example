# Copy on VPS:  cp deployment/env.example /var/www/the-hidden-truth/.env
# Public URL: https://bitmat.vinhtieng.com (TLS at Cloudflare; VPS HTTP only)

NODE_ENV=production
PORT=2567

# Optional: extra CORS origins (comma-separated), besides https://bitmat.vinhtieng.com
# ALLOWED_ORIGINS=
ALLOWED_ORIGIN=https://bitmat.vinhtieng.com

# Voice TURN relay — written by deployment/coturn/setup.sh (unset = STUN only)
# TURN_SECRET=
# TURN_HOST=3.106.54.104
# TURN_TLS_HOST=

# Cloudflare Realtime TURN — preferred over coturn when set (dash.cloudflare.com → Realtime → TURN)
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=